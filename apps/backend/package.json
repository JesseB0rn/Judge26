{
  "name": "@judge26/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "install-pocketbase": "node scripts/install-pocketbase.mjs",
    "dev": "pnpm engine && node scripts/pocketbase.mjs serve",
    "serve:test": "pnpm engine && PB_ENV=test node scripts/pocketbase.mjs serve",
    "migrate": "node scripts/pocketbase.mjs migrate",
    "superuser": "node scripts/pocketbase.mjs superuser",
    "type-check": "tsc --noEmit",
    "test": "pnpm engine && vitest run",
    "seed": "node scripts/seed-dev.mjs",
    "engine": "pnpm --filter @judge26/scoring-engine build:hooks && pnpm --filter @judge26/ranking-engine build:hooks"
  },
  "devDependencies": {
    "@judge26/ranking-engine": "workspace:^",
    "@judge26/scoring-engine": "workspace:^",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24",
    "pocketbase": "0.28.2",
    "typescript": "~6.0.0",
    "vitest": "4.1.12"
  }
}
