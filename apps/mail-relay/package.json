{
  "name": "@judge26/mail-relay",
  "private": true,
  "type": "module",
  "description": "SMTP relay that delivers PocketBase's mail with OAuth 2.0 (XOAUTH2) to Microsoft 365 (M9-D).",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start": "node src/index.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "nodemailer": "10.3.1",
    "smtp-server": "3.21.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "~6.0.0",
    "vitest": "4.1.12"
  }
}
