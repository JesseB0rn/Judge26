    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "papaparse": "^5.7.0",
    "pinia": "^4.0.3",
    "pocketbase": "^0.28.2",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
