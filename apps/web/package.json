{
  "name": "@judge26/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build --mode production",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "type-check": "vue-tsc --build",
    "lint": "oxlint . && eslint . --cache",
    "lint:fix": "oxlint . --fix && eslint . --fix --cache",
