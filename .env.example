# Copy to .env and adjust (docs/operations/deployment.md). Never commit .env.

# Image tag to build or pull, and its version information (shown at /api/app/info).
JUDGE26_IMAGE=judge26:local
APP_VERSION=dev
GIT_COMMIT=unknown
JUDGE26_PORT=8090

# Public URL (email links). With Caddy: https://<DOMAIN>
APP_URL=http://localhost:8090
# HTTPS with docker-compose.caddy.yml
DOMAIN=
ACME_EMAIL=

# Superuser for the dashboard (/_/) and backups. Use a long random password.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
# 32 random characters, e.g. `openssl rand -hex 16`. Set once; never change it afterwards.
PB_ENCRYPTION_KEY=

# Email (M7-01)
MAIL_SENDER_ADDRESS=
MAIL_SENDER_NAME=Judge26
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false

# Backups (docs/operations/backup-and-restore.md): cron expression or "off"
BACKUP_CRON=30 3 * * *
BACKUP_MAX_KEEP=14

TZ=Europe/Zurich
