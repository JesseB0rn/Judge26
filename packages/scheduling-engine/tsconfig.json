{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"]
  }
}
